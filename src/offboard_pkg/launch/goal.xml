<?xml version="1.0"?>
<root>
    <!-- 航点类型说明:
         type="0" (默认): 普通航点，先旋转对准再直行，到达精度范围内完成
         type="1": 视觉航点，需要视觉检测目标来计算实际坐标 (暂不使用)
         type="2": 原地左转90度 (保留，暂不使用)
         type="3": 原地右转90度 (保留，暂不使用)
         type="4": 前瞻转向航点
                   - 在距离 < lookahead_distance 时启用边走边转向
                   - 完成条件: 车头对准下一个目标点 (而非到达该点)
    -->
    
    <!-- 视觉穿门(1) -->
   <!-- <waypoint x="2.25" y="0.16" type="1"/>  -->

    <!-- 前瞻转向(1) -->
    <waypoint x="4.87" y="0.08" type="4"/>

    <!--视觉穿门-->
    <waypoint x="4.90" y="-2.20" type="1"/>


    <!--前瞻转向-->
    <waypoint x="5.03" y="-3.72" type="4"/>

    <!--视觉穿门-->
    <waypoint x="2.50" y="-4.10" type="1"/>

    <!-- <waypoint x="2.4" y="-4.20" /> -->
    <!--终点-->
    <waypoint x="0.10" y="-4.10"/> 

    <waypoint x="0.15" y="-3.40"/>

</root>
